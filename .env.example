# TAZAMA environment contract (PRD section 4).
# Copy to .env and fill in. NO REAL VALUES IN THIS FILE — it is committed.
# Every variable below is read in exactly one place: backend/src/tazama/core/settings.py
# The app fails fast at startup and lists every missing/invalid variable.

# ------------------------------------------------------------------ App
APP_ENV=local                       # local | dev | staging | prod
APP_MODE=demo                       # demo (seed data, writes allowed) | live (read-only sources)
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
DISPLAY_TZ=Africa/Nairobi           # presentation only; everything is STORED in UTC
ALLOW_LIVE_WRITES=false             # must stay false unless a human deliberately flips it

# ------------------------------------------------- Database (app schema)
# DB_BACKEND=sqlite needs nothing else and is the default for demo/CI (see docs/adr/0002).
DB_BACKEND=sqlite                   # sqlite | oracle
SQLITE_PATH=./data/tazama.db        # used when DB_BACKEND=sqlite
ORACLE_USER=tazama
ORACLE_PASSWORD=change-me
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=8
ORACLE_WALLET_DIR=                  # optional; path to a wallet directory for mTLS/ADB

# ------------------------------- Oracle live read-only source (APP_MODE=live)
SOURCE_ORACLE_USER=
SOURCE_ORACLE_PASSWORD=
SOURCE_ORACLE_DSN=
SOURCE_QUERY_TIMEOUT_S=30
SOURCE_MAX_ROWS=5000

# ------------------------------------------------------- LLM (internal Qwen)
# Leave LLM_BASE_URL empty to run fully offline: the gateway reports "AI degraded"
# and every AI feature falls back to its deterministic path.
LLM_BASE_URL=                       # e.g. http://llm.internal.example/v1
LLM_API_KEY=
LLM_MODEL_REASONING=qwen-reasoning
LLM_MODEL_FAST=qwen-fast
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_TOOL_CALLING=auto               # auto | on | off
LLM_CACHE_TTL_S=900
LLM_MAX_PROMPT_CHARS=24000

# ----------------------------------------------------------- Embeddings / RAG
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen-embedding
EMBEDDING_DIM=256                   # must match the vector column when VECTOR_BACKEND=oracle
VECTOR_BACKEND=memory               # memory | oracle

# ---------------------------------------------------------------- Teams
TEAMS_WORKFLOW_WEBHOOK_URL=         # SECRET. Power Automate Workflows URL. Never logged.
TEAMS_DRY_RUN=true                  # true = render + log + preview only, no HTTP call

# -------------------------------------------------------------- Security
PSEUDONYM_SALT=replace-with-32-plus-random-chars-before-use
AUTH_MODE=dev                       # dev (local users) | oidc
DEV_USERS=admin:admin,noc:noc,care:care,analyst:analyst,manager:manager
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
JWT_SECRET=replace-with-32-plus-random-chars-before-use
JWT_TTL_S=3600
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MIN=120
SQL_EXPLORER_MAX_ROWS=1000
SQL_EXPLORER_TIMEOUT_S=15

# ---------------------------------------------------------- Integrations
SMS_GATEWAY_MODE=mock               # mock only in v1
SOCIAL_SIGNALS_ENABLED=false
ADAPTER_MODE=mock                   # mock | live_stub

# --------------------------------------------------------- Observability
OTEL_EXPORTER_OTLP_ENDPOINT=        # empty = tracing stays in-process, no exporter
OTEL_SERVICE_NAME=tazama-api

# ------------------------------------------------- AI capability kill switches
AI_CLASSIFICATION_ENABLED=true
AI_DIAGNOSIS_AGENT_ENABLED=true
AI_KNOWLEDGE_ASSISTANT_ENABLED=true
AI_REPORTER_ENABLED=true
AI_GNN_ENABLED=false                # scaffold only; must beat LightGBM first
AI_BANDIT_ENABLED=false             # scaffold only; never on the live network

# ------------------------------------------------------------------- Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAP_TILE_URL=           # empty = blank base map (works offline)
NEXT_PUBLIC_APP_MODE=demo
