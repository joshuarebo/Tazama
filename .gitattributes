# Normalise to LF in the repository so Linux CI and Windows developers agree.
* text=auto eol=lf

*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

uv.lock linguist-generated=true
package-lock.json linguist-generated=true
docs/openapi.json linguist-generated=true
